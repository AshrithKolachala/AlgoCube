{
  "name": "algocube-119",
  "productName": "AlgoCube 119",
  "version": "1.0.0",
  "description": "AlgoCube 119 desktop app",
  "main": "main.js",
  "author": "AlgoCube 119",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.example.algocube119",
    "productName": "AlgoCube 119",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
